# Copy to .env and fill in real values. NEVER commit .env.

# Flask
FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-me-to-a-long-random-string

# Database (SQLite default)
DATABASE_URL=sqlite:///instance/kahoot.db

# LLM (needed for Part 1.2 only — set at least one)
# Recommended: Google Gemini has a free tier with no credit card required.
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional alternative — if GOOGLE_API_KEY is unset the pipeline falls back to Claude.
ANTHROPIC_API_KEY=
