# Copy to .env and fill in real values. NEVER commit .env.

# Flask
FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-me-to-a-long-random-string

# Database (SQLite default). Leave DATABASE_URL unset locally — Flask-SQLAlchemy
# resolves a relative sqlite:/// URI relative to the instance folder (already
# named "instance"), so setting it to sqlite:///instance/kahoot.db doubles up
# to instance/instance/kahoot.db. config.py's built-in default already points
# at the right absolute path.
# DATABASE_URL=

# LLM (needed for Part 1.2 only)
# Groq — free tier, no credit card required.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
