# Copy to .env and fill in real values. NEVER commit .env.

# Flask
FLASK_APP=run.py
FLASK_CONFIG=development
SECRET_KEY=change-me-to-a-long-random-string

# Separate secret from SECRET_KEY on purpose — encrypts user-saved BYOK
# provider API keys at rest (app/crypto_utils.py, app/models.py's
# UserApiKey). Rotating this makes previously-saved keys undecryptable —
# each is just skipped for future runs (a warning is logged), not a crash.
# Required in production, same as SECRET_KEY.
API_KEY_ENCRYPTION_KEY=change-me-to-a-different-long-random-string

# Database (Postgres only — required, no SQLite fallback). Point this at a
# local Postgres instance; see README for setup.
DATABASE_URL=postgresql://kahoot_lite:kahoot_lite_dev@localhost:5432/kahoot_lite

# LLM (needed for Part 1.2 only)
# Groq — free tier, no credit card required.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional — fallback tier if every Groq model in GROQ_MODEL_CHAIN is
# rate-limited/exhausted. Free key at https://build.nvidia.com. Leave unset
# to skip this tier entirely.
NVIDIA_API_KEY=

# Optional — fallback tier if every Groq AND NVIDIA model above is
# exhausted/blocked. Free key at https://openrouter.ai/keys. Leave unset
# to skip this tier entirely. (Also used by evals/'s judge — see below —
# with a separate key, OPENROUTER_JUDGE_API_KEY, so the two uses stay
# independently trackable.)
OPENROUTER_API_KEY=

# Optional — last-resort fallback tier if every Groq AND NVIDIA AND
# OpenRouter model above is exhausted/blocked. Advertises a 5M-token free
# grant for new accounts, but this was confirmed NOT reliably issued
# (verified live 2026-08 via DeepSeek's own /user/balance endpoint showing
# granted_balance == 0.00 on a fresh account, nothing on the billing
# dashboard either) — check platform.deepseek.com's billing page before
# relying on it. Free key at https://platform.deepseek.com/api_keys.
# Leave unset to skip this tier entirely.
DEEPSEEK_API_KEY=

# Optional — 7 more known-provider fallback tiers, same "leave unset to
# skip entirely" shape as the 4 above. Mainly here so the server can ALSO
# use one as its own fallback if desired; regular users don't need any of
# these set server-side at all — they can add their own key for any of
# these 11 providers on the Settings -> API Keys page (BYOK), which reads
# from the database, not these env vars.
OPENAI_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
FIREWORKS_API_KEY=
PERPLEXITY_API_KEY=

# Optional — lets the pipeline enrich thin/definitional documents with
# external "why does this matter" context via web search, so it can still
# write genuine two-hop questions instead of giving up. Free tier (1,000
# searches/month, no credit card) — sign up at https://tavily.com. Leave
# unset to skip this feature entirely; the rest of the pipeline is
# unaffected.
TAVILY_API_KEY=

# Optional — set to 1 to make the pipeline check thin/definitional
# documents for enrichment proactively, before the first generate attempt
# (needs TAVILY_API_KEY above too). Off by default: enrichment still
# happens reactively on a retry after a failed attempt leaks heavily
# closed-book, just not on the first pass.
ENABLE_PROACTIVE_ENRICHMENT=

# evals/ — independent correctness-checking package, decoupled from the
# pipeline above (see evals/README.md). Not needed to run the app itself.

# Required only to run evals/'s LLM judge. Falls back to OPENROUTER_API_KEY
# above if unset — set a separate key here to keep the pipeline's and the
# judge's usage independently trackable (see evals/README.md). Free at
# https://openrouter.ai/keys, no credit card, no balance issues for
# ":free"-suffixed models (unlike DEEPSEEK_API_KEY above).
OPENROUTER_JUDGE_API_KEY=

# Optional — enables MLflow run logging (judge calibration + per-quiz
# metrics). Local dev: point at a local folder, e.g. ./mlruns, then run
# `mlflow ui`. Leave unset to no-op both the routes.py hook and evals/'s
# CLI tools; everything else still works.
MLFLOW_TRACKING_URI=

# Optional — DeepEval's hosted dashboard (https://confident-ai.com). Leave
# unset to keep everything local-only.
CONFIDENT_API_KEY=
